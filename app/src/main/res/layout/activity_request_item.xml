<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_back_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/brand_navy" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Request an Item"
                android:textColor="@color/brand_navy"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:text="Tell your campus what you need. Someone might be able to help!"
                android:textColor="@color/brand_slate"
                android:textSize="11.5sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Form Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Informational Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/brand_blue_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/btn_secondary_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_action_request"
                        app:tint="@color/brand_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="2dp"
                        android:text="Quick Campus Request: Your post will rotate live in the Home screen Glance feed so students near you can reach out immediately."
                        android:textColor="@color/brand_navy"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Item Name (Required) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-bold"
                android:text="Item Name *"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etRequestItemName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif-medium"
                android:hint="e.g. Scientific Calculator, Type-C HDMI Dongle"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/input_hint"
                android:textSize="13sp" />

            <!-- 2. Needed At Location (Required) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="Needed At *"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:text="Where do you need the item delivered or handed over?"
                android:textColor="@color/brand_slate"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etRequestNeededAt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif-medium"
                android:hint="e.g. College Library, Computer Lab 3, Canteen"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/input_hint"
                android:textSize="13sp" />

            <!-- 3. Description (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="Description &amp; Reason (Optional)"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etRequestDescription"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="e.g. Need this for today's practical examination in Lab 2..."
                android:inputType="textMultiLine"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/input_hint"
                android:textSize="13sp" />

            <!-- 4. Category (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="Category (Optional)"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRequestCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqCatTech"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tech &amp; Chargers" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqCatBooks"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Books &amp; Notes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqCatLab"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lab &amp; Aprons" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqCatEvent"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Event &amp; AV Kits" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqCatStationery"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stationery &amp; Tools" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqCatSports"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sports &amp; Fitness" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 5. Quantity (Optional) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Quantity (Optional)"
                        android:textColor="@color/brand_navy"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif"
                        android:text="How many do you need?"
                        android:textColor="@color/brand_slate"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_back_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQtyMinus"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="-"
                        android:textColor="@color/brand_navy"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/brand_navy"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQtyPlus"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+"
                        android:textColor="@color/brand_navy"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 6. Needed By (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Needed By (Optional)"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:text="When do you need this item by?"
                android:textColor="@color/brand_slate"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupNeededBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNeededAsap"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="ASAP" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNeeded2Hours"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Within 2 Hours" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNeededToday"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNeededTomorrow"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tomorrow" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNeededCustom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom Time" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 7. Request Expiration -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Request Expiration *"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:text="Your request will automatically disappear from the active campus feed after it expires."
                android:textColor="@color/brand_slate"
                android:textSize="11sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupExpiration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExp6h"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 Hours" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExp12h"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Hours" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExp24h"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="24 Hours (Default)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExp48h"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="48 Hours (Maximum)" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishRequest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/btn_primary"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Publish Request"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
