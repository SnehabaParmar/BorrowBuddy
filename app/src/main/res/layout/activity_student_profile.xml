<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootStudentProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_canvas"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_canvas"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/brand_navy" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Student Profile"
                android:textColor="@color/brand_navy"
                android:textSize="17sp" />

            <!-- Safety & Report Overflow Action Button -->
            <ImageView
                android:id="@+id/btnProfileSafety"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Safety options"
                android:padding="9dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/brand_blue" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light" />

        <!-- Main Scrollable Profile Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="36dp">

                <!-- ========================================================== -->
                <!-- A. STUDENT IDENTITY HEADER                                 -->
                <!-- ========================================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStudentIdentity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Profile Avatar with Initials & Optional Photo -->
                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp">

                                <TextView
                                    android:id="@+id/tvStudentAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_fab_gradient"
                                    android:fontFamily="sans-serif-black"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    tools:text="PP" />

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivStudentAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"
                                    app:shapeAppearanceOverlay="@style/CircularAvatarOverlay" />
                            </FrameLayout>

                            <!-- Name & Verification Column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvStudentName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:fontFamily="sans-serif-black"
                                        android:maxLines="1"
                                        android:textColor="@color/brand_navy"
                                        android:textSize="17.5sp"
                                        tools:text="Priya Patel" />

                                    <!-- Campus Verified Badge (Genuine check) -->
                                    <ImageView
                                        android:id="@+id/ivVerifiedBadge"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="5dp"
                                        android:contentDescription="Campus Verified Student"
                                        android:src="@drawable/ic_verified_badge"
                                        app:tint="@color/brand_turquoise" />
                                </LinearLayout>

                                <!-- Department & Semester -->
                                <TextView
                                    android:id="@+id/tvStudentDept"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:textColor="@color/brand_blue"
                                    android:textSize="12sp"
                                    tools:text="IMSc.IT • 4th Semester" />

                                <!-- Verified Pill -->
                                <LinearLayout
                                    android:id="@+id/layoutVerifiedPill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/bg_green_pill"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="7dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="2dp">

                                    <ImageView
                                        android:layout_width="11dp"
                                        android:layout_height="11dp"
                                        android:contentDescription="Verified"
                                        android:src="@drawable/ic_shield"
                                        app:tint="#047857" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="sans-serif-bold"
                                        android:text="Campus Verified Peer"
                                        android:textColor="#047857"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Optional Short Bio Container -->
                        <TextView
                            android:id="@+id/tvStudentBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_stat_cell"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/text_dark"
                            android:textSize="12sp"
                            tools:text="Electronics &amp; IoT enthusiast. Always carrying spare calculators and lab tools." />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/border_light" />

                        <!-- College / Campus Location -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="Campus"
                                android:src="@drawable/ic_location_pin"
                                app:tint="@color/brand_slate" />

                            <TextView
                                android:id="@+id/tvStudentCollege"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                tools:text="Gujarat University • Campus North" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================================== -->
                <!-- B. BORROWBUDDY ACTIVITY                                    -->
                <!-- ========================================================== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-black"
                    android:text="BorrowBuddy Activity"
                    android:textColor="@color/brand_navy"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStudentStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <!-- 1. Items Listed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatListingsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/brand_navy"
                                android:textSize="16sp"
                                tools:text="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Items Listed"
                                android:textColor="@color/brand_slate"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/border_light" />

                        <!-- 2. Successful Lends -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatLendsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/brand_navy"
                                android:textSize="16sp"
                                tools:text="18" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Shared"
                                android:textColor="@color/brand_slate"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/border_light" />

                        <!-- 3. Successful Borrows -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatBorrowsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/brand_navy"
                                android:textSize="16sp"
                                tools:text="5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Borrowed"
                                android:textColor="@color/brand_slate"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <View
                            android:id="@+id/dividerRating"
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/border_light" />

                        <!-- 4. Rating (Displayed only when genuine rating exists) -->
                        <LinearLayout
                            android:id="@+id/layoutStatRating"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/star_gold"
                                android:textSize="16sp"
                                tools:text="★ 5.0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Rating"
                                android:textColor="@color/brand_slate"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================================== -->
                <!-- C. CURRENTLY AVAILABLE LISTINGS                            -->
                <!-- ========================================================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvListingsHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/brand_navy"
                        android:textSize="14sp"
                        tools:text="Available Listings (1)" />

                    <TextView
                        android:id="@+id/tvListingsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Campus Peer Items"
                        android:textColor="@color/brand_slate"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Empty State Container -->
                <LinearLayout
                    android:id="@+id/layoutEmptyListings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_white"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Empty"
                        android:src="@drawable/ic_search"
                        app:tint="@color/brand_slate" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="No Active Listings"
                        android:textColor="@color/brand_navy"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="This student currently has no items available for borrowing."
                        android:textColor="@color/brand_slate"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- RecyclerView for Student's Available Items -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStudentListings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false" />

                <!-- ========================================================== -->
                <!-- D. PROFILE SAFETY & TRUST                                  -->
                <!-- ========================================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Safety"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/brand_blue" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="Campus Safety &amp; Trust"
                                android:textColor="@color/brand_navy"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="2dp"
                            android:text="All handovers should take place at designated campus safe spots during daytime. Need moderation assistance?"
                            android:textColor="@color/brand_slate"
                            android:textSize="11.5sp" />

                        <!-- Safety Action Buttons Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReportStudent"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Report Student"
                                android:textAllCaps="false"
                                android:textColor="#B91C1C"
                                android:textSize="11.5sp"
                                app:cornerRadius="10dp"
                                app:strokeColor="#FCA5A5" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBlockStudent"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Block Student"
                                android:textAllCaps="false"
                                android:textColor="@color/brand_slate"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
