<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:orientation="vertical">

    <!-- Top Pinned Header: Main Title, Primary Segmented BORROW/LEND, and Secondary Category Tabs -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/splash_bg"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Exchanges"
            android:textColor="@color/brand_navy"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Manage your borrowing and lending activities."
            android:textColor="@color/brand_slate"
            android:textSize="12sp" />

        <!-- Primary Navigation: Main Segmented Tab Bar (BORROW vs LEND) -->
        <LinearLayout
            android:id="@+id/layoutSegmentedTabs"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_segmented_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- Borrow Tab -->
            <LinearLayout
                android:id="@+id/tabBorrow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTabBorrowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="BORROW"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <!-- Unseen Activity Turquoise Dot -->
                <View
                    android:id="@+id/dotBorrowUnseen"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_dot_unseen_turquoise"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Lend Tab -->
            <LinearLayout
                android:id="@+id/tabLend"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTabLendLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="LEND"
                    android:textColor="@color/brand_slate"
                    android:textSize="12sp" />

                <!-- Unseen Activity Turquoise Dot -->
                <View
                    android:id="@+id/dotLendUnseen"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_dot_unseen_turquoise"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Secondary Navigation: BORROW Three-Tab Selector with Sliding Underline -->
        <LinearLayout
            android:id="@+id/layoutBorrowCategorySelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="visible"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Pending Tab -->
                <LinearLayout
                    android:id="@+id/catBorrowPending"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvCatBorrowPendingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Pending (1)"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/dotCatBorrowPending"
                        android:layout_width="5.5dp"
                        android:layout_height="5.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_dot_unseen_turquoise"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Active Tab -->
                <LinearLayout
                    android:id="@+id/catBorrowActive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvCatBorrowActiveLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Active (2)"
                        android:textColor="@color/brand_slate"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/dotCatBorrowActive"
                        android:layout_width="5.5dp"
                        android:layout_height="5.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_dot_unseen_turquoise"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- History Tab -->
                <LinearLayout
                    android:id="@+id/catBorrowHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvCatBorrowHistoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="History (2)"
                        android:textColor="@color/brand_slate"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/dotCatBorrowHistory"
                        android:layout_width="5.5dp"
                        android:layout_height="5.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_dot_unseen_turquoise"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Underline Track & Sliding Active Blue Indicator -->
            <FrameLayout
                android:id="@+id/trackBorrowUnderline"
                android:layout_width="match_parent"
                android:layout_height="2.5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="bottom"
                    android:background="@color/border_light" />

                <View
                    android:id="@+id/indicatorBorrow"
                    android:layout_width="0dp"
                    android:layout_height="2.5dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_tab_indicator_blue" />
            </FrameLayout>
        </LinearLayout>

        <!-- Secondary Navigation: LEND Three-Tab Selector with Sliding Underline -->
        <LinearLayout
            android:id="@+id/layoutLendCategorySelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Incoming Tab -->
                <LinearLayout
                    android:id="@+id/catLendIncoming"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvCatLendIncomingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Incoming (2)"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/dotCatLendIncoming"
                        android:layout_width="5.5dp"
                        android:layout_height="5.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_dot_unseen_turquoise"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- Active Tab -->
                <LinearLayout
                    android:id="@+id/catLendActive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvCatLendActiveLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="Active (2)"
                        android:textColor="@color/brand_slate"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/dotCatLendActive"
                        android:layout_width="5.5dp"
                        android:layout_height="5.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_dot_unseen_turquoise"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- History Tab -->
                <LinearLayout
                    android:id="@+id/catLendHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvCatLendHistoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="History (2)"
                        android:textColor="@color/brand_slate"
                        android:textSize="12sp" />

                    <View
                        android:id="@+id/dotCatLendHistory"
                        android:layout_width="5.5dp"
                        android:layout_height="5.5dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_dot_unseen_turquoise"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Underline Track & Sliding Active Blue Indicator -->
            <FrameLayout
                android:id="@+id/trackLendUnderline"
                android:layout_width="match_parent"
                android:layout_height="2.5dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="bottom"
                    android:background="@color/border_light" />

                <View
                    android:id="@+id/indicatorLend"
                    android:layout_width="0dp"
                    android:layout_height="2.5dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_tab_indicator_blue" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content with Full Category Heading and Exchange Cards -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Full Heading of Selected Category -->
            <TextView
                android:id="@+id/tvCategoryHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Pending Requests"
                android:textColor="@color/brand_navy"
                android:textSize="16sp" />

            <!-- Single Container for Active Category Exchange Cards -->
            <LinearLayout
                android:id="@+id/layoutExchangeCardsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
