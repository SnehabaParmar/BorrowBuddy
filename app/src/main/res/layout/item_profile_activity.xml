<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowActivityContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Thumbnail Image / Category Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <FrameLayout
                android:id="@+id/layoutFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_image_fallback"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivFallbackIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Category Icon"
                    android:src="@drawable/ic_cat_tech"
                    app:tint="@color/brand_blue" />
            </FrameLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivActivityThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/brand_blue_light"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_fallback"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
        </FrameLayout>

        <!-- Activity Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActivityItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/brand_navy"
                android:textSize="13.5sp"
                tools:text="Scientific Calculator" />

            <TextView
                android:id="@+id/tvActivityDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/brand_slate"
                android:textSize="12sp"
                tools:text="You borrowed this item." />

            <TextView
                android:id="@+id/tvActivityDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/brand_slate"
                android:textSize="11sp"
                tools:text="22 Nov 2026" />
        </LinearLayout>

    </LinearLayout>

    <!-- Subtle Divider between entries -->
    <View
        android:id="@+id/dividerActivity"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

</LinearLayout>
