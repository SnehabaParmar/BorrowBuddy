<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <!-- Top Drag Handle & Close Button Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_bar" />

        <ImageView
            android:id="@+id/btnCloseDetail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_slate" />
    </RelativeLayout>

    <!-- Scrollable Detail Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- ==================== SECTION 1: MEDIA & TITLE HEADER ==================== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/brand_blue_light"
                    android:scaleType="centerCrop"
                    android:src="@drawable/item_calculator"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

                <!-- Top Left: "Available Now" Status Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_green_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_avatar_mini"
                        android:backgroundTint="#10B981" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Available Now"
                        android:textColor="#047857"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Top Right: "FREE" or "₹[amount]/day" Badge -->
                <TextView
                    android:id="@+id/tvDetailBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_badge_free"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="FREE"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- Multi-photo thumbnail strip (shown when item has multiple photos) -->
            <LinearLayout
                android:id="@+id/layoutDetailThumbnails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivThumb0"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                    app:strokeColor="@color/brand_blue"
                    app:strokeWidth="2dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivThumb1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                    app:strokeColor="@color/btn_secondary_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivThumb2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                    app:strokeColor="@color/btn_secondary_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Full Item Title & Category / Department Tag -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_navy"
                android:textSize="20sp"
                tools:text="Scientific Calculator (Casio fx-991EX)" />

            <TextView
                android:id="@+id/tvDetailCategoryDept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_blue"
                android:textSize="12sp"
                tools:text="Lab &amp; Study Tools • IMSc.IT Department" />

            <!-- ==================== SECTION 2: LENDER'S DESCRIPTION & SPECS ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/brand_canvas"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Description &amp; Usage Notes"
                        android:textColor="@color/brand_navy"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/brand_slate"
                        android:textSize="12.5sp"
                        tools:text="Casio ClassWiz fx-991EX in pristine condition. Covers matrix operations, statistics, integration, and quadratic equations. Please return before 5 PM on exam days." />

                    <!-- 3 Compact Info Pills (Condition, Max Duration, Security Deposit) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <!-- Condition Pill -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_spec_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Condition"
                                android:textColor="@color/brand_slate"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvSpecCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/brand_navy"
                                android:textSize="11.5sp"
                                tools:text="Like New" />
                        </LinearLayout>

                        <!-- Max Duration Pill -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_spec_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Max Duration"
                                android:textColor="@color/brand_slate"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvSpecDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/brand_navy"
                                android:textSize="11.5sp"
                                tools:text="Up to 3 days" />
                        </LinearLayout>

                        <!-- Deposit Pill -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_spec_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Security Deposit"
                                android:textColor="@color/brand_slate"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvSpecDeposit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/brand_navy"
                                android:textSize="11.5sp"
                                tools:text="None" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== SECTION 3: LENDER CARD (TRUST) ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Lender Initial Avatar -->
                    <TextView
                        android:id="@+id/tvLenderAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_avatar_mini"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/brand_blue"
                        android:textSize="16sp"
                        tools:text="P" />

                    <!-- Lender Name, Course, Rating & Lends Count -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLenderName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/brand_navy"
                            android:textSize="14sp"
                            tools:text="Priya Patel" />

                        <TextView
                            android:id="@+id/tvLenderCourse"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/brand_slate"
                            android:textSize="11.5sp"
                            tools:text="IMSc.IT Sem 4" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLenderRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/brand_navy"
                                android:textSize="11.5sp"
                                tools:text="★ 5.0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:text="•"
                                android:textColor="@color/brand_slate"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvLenderLendsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#047857"
                                android:textSize="11sp"
                                tools:text="14 campus lends" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Secondary Outline "Message" Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMessageLender"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/white"
                        android:fontFamily="sans-serif-bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Message"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_message_outline"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/brand_blue"
                        app:strokeColor="@color/border_light" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== SECTION 4: PICKUP & SETTLEMENT INFO ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/brand_canvas"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Landmark row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/brand_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Handover Landmark"
                            android:textColor="@color/brand_navy"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailSpot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/brand_slate"
                        android:textSize="12sp"
                        tools:text="Main Library Entrance • 2 min walk" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/border_light" />

                    <!-- Peer Settlement Note -->
                    <TextView
                        android:id="@+id/tvSettlementNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/brand_slate"
                        android:textSize="11.5sp"
                        tools:text="Free Peer Lending (₹0) — Settle directly with lender at pickup. No payment gateway or commission." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ==================== SECTION 5: STICKY BOTTOM CTA ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestBorrow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/btn_primary"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Request to Borrow"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
