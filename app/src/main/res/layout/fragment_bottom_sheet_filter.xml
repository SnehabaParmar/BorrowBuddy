<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip_unselected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Filter Campus Items"
            android:textColor="@color/brand_navy"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnResetFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Reset"
            android:textColor="@color/brand_blue"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:text="Narrow down items by price, department and campus zone."
        android:textColor="@color/brand_slate"
        android:textSize="12sp" />

    <!-- 1. Price Filter -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="Price"
        android:textColor="@color/brand_navy"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgFilterPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbPriceAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="sans-serif-medium"
            android:text="All"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbPriceFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="Free Only"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbPricePaid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="Paid (₹/day)"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />
    </RadioGroup>

    <!-- 2. Department Filter -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Department"
        android:textColor="@color/brand_navy"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgFilterDept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbDeptAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="sans-serif-medium"
            android:text="All"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbDeptIMBA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="IMBA"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbDeptIMSC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="IMSc.IT"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />
    </RadioGroup>

    <!-- 3. Campus Zone Filter -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Campus Zone / Proximity"
        android:textColor="@color/brand_navy"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rgFilterZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbZoneAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="sans-serif-medium"
            android:text="All Campus Zones"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbZoneLib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Main Library (Closest to CS/IT)"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbZoneIMBA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="IMBA Block"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbZoneLab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="IMSc.IT Lab"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbZoneCanteen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Campus Canteen"
            android:textColor="@color/brand_navy"
            android:textSize="12.5sp" />
    </RadioGroup>

    <!-- Apply Filters Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilters"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brand_blue"
        android:fontFamily="sans-serif-black"
        android:text="Apply Filters"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:cornerRadius="25dp" />

</LinearLayout>
