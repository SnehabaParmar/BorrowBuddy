<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTrendingItem"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1.5dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Image & Floating Badges -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="108dp">

            <!-- Fallback Category Placeholder -->
            <FrameLayout
                android:id="@+id/layoutTrendingFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_image_fallback"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivTrendingFallbackIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cat_tech"
                    app:tint="@color/brand_blue" />
            </FrameLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivTrendingImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/brand_blue_light"
                android:scaleType="centerCrop"
                android:src="@drawable/item_calculator"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Top-Left: "Popular" Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_trending_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_trending" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-black"
                    android:text="POPULAR"
                    android:textColor="#B45309"
                    android:textSize="8.5sp" />
            </LinearLayout>

            <!-- Top-Right: FREE / ₹[amount]/day Badge -->
            <TextView
                android:id="@+id/tvTrendingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge_free"
                android:fontFamily="sans-serif-black"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="FREE"
                android:textColor="@color/white"
                android:textSize="9.5sp" />
        </FrameLayout>

        <!-- Item Title (1-2 lines bold) -->
        <TextView
            android:id="@+id/tvTrendingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/brand_navy"
            android:textSize="13sp"
            tools:text="Scientific Calculator" />

        <!-- Location Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/brand_slate" />

            <TextView
                android:id="@+id/tvTrendingSpot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/brand_slate"
                android:textSize="10.5sp"
                tools:text="Main Library • 2m" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="5dp"
            android:background="#F1F5F9" />

        <!-- Footer: Owner & Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrendingOwnerAvatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_avatar_mini"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/brand_blue"
                android:textSize="9sp"
                tools:text="P" />

            <TextView
                android:id="@+id/tvTrendingOwnerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/brand_navy"
                android:textSize="10.5sp"
                tools:text="Priya" />

            <TextView
                android:id="@+id/tvTrendingRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/brand_navy"
                android:textSize="10.5sp"
                tools:text="★ 5.0" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
