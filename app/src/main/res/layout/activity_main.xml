<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    tools:context=".MainActivity">

    <!-- Fragment Container for Home, Explore, Exchanges, Profile -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dynamic Animated Curved Bottom Navigation Bar (Active tab comes out with curved notch) -->
    <com.borrowbuddy.app.ui.CurvedBottomNavView
        android:id="@+id/curvedBottomNav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
