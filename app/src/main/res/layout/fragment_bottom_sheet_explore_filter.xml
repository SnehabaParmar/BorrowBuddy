<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chip_unselected" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Filter &amp; Sort Marketplace"
            android:textColor="@color/brand_navy"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnResetFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:padding="4dp"
            android:text="Reset All"
            android:textColor="@color/brand_blue"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="Refine listings across Gujarat University campus."
        android:textColor="@color/brand_slate"
        android:textSize="12sp" />

    <!-- Scrollable Filter Options -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- 1. SORTING OPTIONS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Sort By"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgSortBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbSortRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Recently Added (Default)"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbSortNearest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Nearest First (Walk Time)"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbSortLowestPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Lowest Price (Free First)"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbSortHighestPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Highest Price"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbSortHighestRated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Highest Rated (★ 5.0)"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_light" />

            <!-- 2. PRICING MODEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Pricing"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgPriceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPriceAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="All"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbPriceFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Free Only"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbPricePaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Paid (₹/day)"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_light" />

            <!-- 3. CAMPUS ZONE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Campus Location / Zone"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbZoneAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="All Campus Zones"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbZoneLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Main Library &amp; Reading Hall"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbZoneIMBA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="IMBA Department Block"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbZoneLab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="IMSc.IT Lab &amp; Science Block"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbZoneCanteen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Campus Canteen &amp; Clock Tower"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_light" />

            <!-- 4. CONDITION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Item Condition"
                android:textColor="@color/brand_navy"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCondAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="All"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />

                <RadioButton
                    android:id="@+id/rbCondLikeNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Like New / Pristine"
                    android:textColor="@color/brand_navy"
                    android:textSize="12.5sp" />
            </RadioGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Apply Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="@color/btn_primary"
            android:fontFamily="sans-serif-bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Apply Filters &amp; Sorting"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
