<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowNotificationContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Category Icon Container -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_image_fallback">

            <ImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Notification Icon"
                android:src="@drawable/ic_cat_tech"
                app:tint="@color/brand_blue" />
        </FrameLayout>

        <!-- Notification Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/brand_navy"
                android:textSize="13.5sp"
                tools:text="New Borrow Request" />

            <TextView
                android:id="@+id/tvNotificationDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/brand_slate"
                android:textSize="12sp"
                tools:text="Meera Trivedi requested to borrow Yonex Badminton Rackets" />

            <TextView
                android:id="@+id/tvNotificationDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/brand_slate"
                android:textSize="11sp"
                tools:text="Today, 11:15 AM" />
        </LinearLayout>

        <!-- Unread Blue Dot -->
        <View
            android:id="@+id/dotUnreadIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dot_unread_blue"
            android:visibility="visible" />

        <!-- Chevron Affordance -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Navigate"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/brand_slate" />

    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:id="@+id/dividerNotification"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

</LinearLayout>
