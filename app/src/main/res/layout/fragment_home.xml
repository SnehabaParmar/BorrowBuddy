<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <!-- 1. TOP HEADER ROW: Logo Mark + Brand & Dynamic Greeting + Notification Bell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo Mark Icon -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Single-Line Greeting: Hello, [FirstName]! -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:textColor="@color/brand_navy"
                android:textSize="17sp"
                tools:text="Hello, Harsh!" />

            <!-- Notification Bell with Unread Dot -->
            <FrameLayout
                android:id="@+id/btnNotificationBell"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_back_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_notification" />

                <!-- Unread Indicator Dot -->
                <View
                    android:id="@+id/viewNotifDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_free" />
            </FrameLayout>

        </LinearLayout>

        <!-- 2. SEARCH BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search Icon"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Search books, gadgets, notes..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/brand_navy"
                android:textColorHint="@color/input_hint"
                android:textSize="13sp" />

            <!-- Clear Search Button -->
            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:visibility="gone" />

            <!-- Filter Toggle Button -->
            <ImageView
                android:id="@+id/btnFilterToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Filter"
                android:padding="7dp"
                android:src="@drawable/ic_filter" />
        </LinearLayout>

        <!-- Collapsible Filter Chips Row -->
        <HorizontalScrollView
            android:id="@+id/scrollFilterChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Free"
                    android:textColor="@color/brand_navy"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipPaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Paid (₹/day)"
                    android:textColor="@color/brand_navy"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipIMBA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="IMBA"
                    android:textColor="@color/brand_navy"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipIMSC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="IMSc.IT"
                    android:textColor="@color/brand_navy"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 3. GLANCE REQUEST STRIP (Midnight Navy Minimal Campus Utility) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGlance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glance_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- AREA 1: MAIN CONTENT (Requested Item Name as Visual Hero - Top of Card) -->
                <TextView
                    android:id="@+id/tvGlanceHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="Scientific Calculator fx-991EX"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <!-- AREA 2: SUPPORTING CONTENT & ACTION (Metadata on left, CTA on right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Requester Initial (Soft, subtle circular badge) -->
                    <TextView
                        android:id="@+id/tvGlanceAvatar"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_glance_avatar"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="H"
                        android:textColor="@color/white"
                        android:textSize="10.5sp" />

                    <!-- Supporting Metadata Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Requester Name & Location -->
                        <TextView
                            android:id="@+id/tvGlanceLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Harsh • College Library"
                            android:textColor="#CBD5E1"
                            android:textSize="11.5sp" />

                        <!-- Needed By Timing (Optional / contextual) -->
                        <TextView
                            android:id="@+id/tvGlanceNeededBy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Needed by Today, 2:00 PM"
                            android:textColor="@color/brand_turquoise"
                            android:textSize="10.5sp" />

                        <!-- Hidden legacy text view for 100% backward compatibility -->
                        <TextView
                            android:id="@+id/tvGlanceText"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Compact "I Can Help →" CTA -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGlanceHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="@color/brand_turquoise"
                        android:fontFamily="sans-serif-bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="I Can Help →"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_navy"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <!-- AREA 3: SUBTLE CAROUSEL PAGINATION (Bottom-Centered) -->
                <LinearLayout
                    android:id="@+id/layoutGlanceDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot0"
                        android:layout_width="12dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_glance_dot_active" />

                    <View
                        android:id="@+id/dot1"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:alpha="0.35"
                        android:background="@drawable/bg_glance_dot_inactive" />

                    <View
                        android:id="@+id/dot2"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="4dp"
                        android:alpha="0.35"
                        android:background="@drawable/bg_glance_dot_inactive" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 4. BROWSE CATEGORIES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Browse Categories"
                android:textColor="@color/brand_navy"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnSeeAllCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="See all"
                android:textColor="@color/btn_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Horizontally Scrollable Category Tiles -->
        <HorizontalScrollView
            android:id="@+id/scrollCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Cat 1: Tech & Gadgets -->
                <LinearLayout
                    android:id="@+id/tileCatTech"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_tech"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Tech &amp; Chargers"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 2: Books & Notes -->
                <LinearLayout
                    android:id="@+id/tileCatBooks"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_books"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Books &amp; Notes"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 3: Lab & Aprons -->
                <LinearLayout
                    android:id="@+id/tileCatLab"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_lab"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Lab &amp; Aprons"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 4: Event & AV -->
                <LinearLayout
                    android:id="@+id/tileCatEvent"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_event"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Event &amp; AV Kits"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 5: Stationery & Tools -->
                <LinearLayout
                    android:id="@+id/tileCatStationery"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_stationery"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Stationery &amp; Tools"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 6: Sports & Fitness -->
                <LinearLayout
                    android:id="@+id/tileCatSports"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_sports"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Sports &amp; Fitness"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 7: Business & IMBA -->
                <LinearLayout
                    android:id="@+id/tileCatBusiness"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_business"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Business &amp; IMBA"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Cat 8: Campus & Admin -->
                <LinearLayout
                    android:id="@+id/tileCatCampus"
                    android:layout_width="92dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_category_tile"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_category_icon_container">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cat_campus"
                            app:tint="@color/brand_blue" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Campus &amp; Admin"
                        android:textColor="@color/brand_navy"
                        android:textSize="10.5sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 5. AVAILABLE NEAR YOU (No limitation, shows all items) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Available near you"
                android:textColor="@color/brand_navy"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="View all"
                android:textColor="@color/btn_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2-Column Grid for Items (NO LIMITATION) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCampusItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="4"
            tools:listitem="@layout/item_campus_card" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="No matching items found"
                android:textColor="@color/brand_navy"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnResetSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-bold"
                android:text="Show all items"
                android:textColor="@color/btn_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
