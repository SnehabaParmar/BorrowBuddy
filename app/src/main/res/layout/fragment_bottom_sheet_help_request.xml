<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_search_bar" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Campus Request"
            android:textColor="@color/brand_navy"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnCloseHelpSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/brand_slate" />
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="A campus peer needs your assistance."
        android:textColor="@color/brand_slate"
        android:textSize="12sp" />

    <!-- Request Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Requester Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHelpAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_free"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="H"
                    android:textColor="@color/brand_navy"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHelpRequesterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/brand_navy"
                        android:textSize="14sp"
                        tools:text="Harsh" />

                    <TextView
                        android:id="@+id/tvHelpStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_green_pill"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="6dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="1dp"
                        android:text="ACTIVE REQUEST"
                        android:textColor="#047857"
                        android:textSize="9.5sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_light" />

            <!-- Item Needed Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Item Requested:"
                android:textColor="@color/brand_slate"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHelpItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/brand_navy"
                android:textSize="16sp"
                tools:text="Scientific Calculator fx-991EX" />

            <!-- Needed At Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="@color/brand_blue" />

                <TextView
                    android:id="@+id/tvHelpLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/brand_navy"
                    android:textSize="12sp"
                    tools:text="Needed at: College Library" />
            </LinearLayout>

            <!-- Needed By Timing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="⏰"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHelpNeededBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/brand_blue"
                    android:textSize="12sp"
                    tools:text="Needed by: Today, 2:00 PM" />
            </LinearLayout>

            <!-- Description / Reason (if present) -->
            <TextView
                android:id="@+id/tvHelpDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:textColor="@color/brand_slate"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="Need this for today's practical examination in Lab 2."
                tools:visibility="visible" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Confirmation Success Box (Hidden initially) -->
    <LinearLayout
        android:id="@+id/layoutHelpSuccessState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_green_pill"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_circle"
                app:tint="#059669" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="Assistance Offered!"
                android:textColor="#047857"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHelpSuccessMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:text="We've shared your offer with the requester. You can coordinate handover at the requested location."
            android:textColor="#065F46"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Primary Action: I Can Lend This -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmHelp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/brand_turquoise"
        android:fontFamily="sans-serif-black"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="I Can Lend This Item"
        android:textAllCaps="false"
        android:textColor="@color/brand_navy"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

    <!-- Optional Request Management: Mark as Fulfilled -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMarkFulfilled"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/white"
        android:fontFamily="sans-serif-bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Mark Request as Fulfilled"
        android:textAllCaps="false"
        android:textColor="@color/brand_navy"
        android:textSize="12.5sp"
        app:cornerRadius="10dp"
        app:strokeColor="@color/border_light" />

</LinearLayout>
