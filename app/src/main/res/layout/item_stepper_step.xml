<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Stepper indicator column -->
    <LinearLayout
        android:layout_width="26dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp">

            <TextView
                android:id="@+id/tvStepNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_stepper_circle_pending"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/brand_slate"
                android:textSize="10.5sp" />

            <ImageView
                android:id="@+id/ivStepCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Vertical connector line -->
        <View
            android:id="@+id/viewStepLine"
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="@color/border_light" />
    </LinearLayout>

    <!-- Step text information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Request Sent"
            android:textColor="@color/brand_navy"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStepDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Borrow request submitted"
            android:textColor="@color/brand_slate"
            android:textSize="10.5sp" />
    </LinearLayout>
</LinearLayout>
